{
  "name": "xamez",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite apps/web --host 0.0.0.0",
    "build": "npm run typecheck && vite build apps/web",
    "preview": "vite preview apps/web --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "schema": "tsx scripts/schema.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json",
    "start": "npm run build && vite preview apps/web --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod-to-json-schema": "3.25.1"
  }
}
